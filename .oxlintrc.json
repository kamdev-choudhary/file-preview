{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-console": "off"
  },
  "ignorePatterns": [
    "dist",
    "dist-demo",
    "node_modules",
    "public"
  ],
  "overrides": [
    {
      "files": [
        "test/**",
        "scripts/**",
        "demo/**"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
