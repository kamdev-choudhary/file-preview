{
  "name": "fileon",
  "version": "1.0.3",
  "description": "Framework-free universal file preview web component. Images, PDF, Office docs, media, code, archives — inline or full-screen modal.",
  "type": "module",
  "license": "MIT",
  "author": "kamdev-choudhary (https://github.com/kamdev-choudhary)",
  "homepage": "https://kamdev-choudhary.github.io/fileon/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamdev-choudhary/fileon.git"
  },
  "bugs": {
    "url": "https://github.com/kamdev-choudhary/fileon/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.11.2",
  "sideEffects": [
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.js",
  "jsdelivr": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "pnpm --filter fileon-site dev",
    "build": "vite build --config vite.lib.config.ts && pnpm run build:types",
    "preview": "pnpm --filter fileon-site preview",
    "samples": "node scripts/make-samples.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src scripts test site/src",
    "format": "prettier --write \"**/*.{js,mjs,ts,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,json,md,html,css}\"",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run size && publint",
    "prepublishOnly": "pnpm run build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:site": "pnpm --filter fileon-site build"
  },
  "keywords": [
    "file-preview",
    "file-viewer",
    "web-component",
    "custom-element",
    "pdf-viewer",
    "docx",
    "xlsx",
    "pptx",
    "lightbox",
    "fileon",
    "typescript"
  ],
  "dependencies": {
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "marked": "^18.0.10",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.0.0",
    "oxlint": "^1.46.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.14",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  }
}
