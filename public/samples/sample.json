{
  "name": "@quartix/file-preview",
  "detection": {
    "order": [
      "magic bytes",
      "extension",
      "declared MIME"
    ]
  },
  "viewers": [
    "image",
    "pdf",
    "sheet",
    "docx",
    "pptx",
    "markdown",
    "text",
    "archive",
    "font",
    "media"
  ],
  "limits": {
    "maxBytes": 104857600,
    "maxTextBytes": 5242880
  },
  "nested": {
    "deeply": {
      "values": [
        1,
        2,
        3,
        null,
        true
      ],
      "unicode": "héllo — wörld ✓"
    }
  }
}